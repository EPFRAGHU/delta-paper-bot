# Copy to .env and fill in. Never share this file.
# Create keys at https://www.delta.exchange/app/account/manageapikeys
# Permissions: Read Data + Trading. Do NOT enable withdrawals. Whitelist your IP.
# Testnet keys come from the Delta India demo account and only work with --mode testnet.
DELTA_API_KEY=
DELTA_API_SECRET=

# Set to YES only after paper + testnet runs look right.
LIVE_CONFIRM=NO
